# Configuración del proyecto de Firebase.
# Copia este archivo como `.env` y pega los valores de la consola de Firebase
# (Configuración del proyecto -> Tus apps -> Configuración del SDK).
#
# Si estas variables NO están definidas, la app arranca en "modo local":
# Auth, Firestore y RealTime Database se resuelven con una capa de respaldo
# sobre localStorage que expone la misma interfaz que los custom hooks.
# Dexie (Fruits) siempre es real porque es IndexedDB del navegador.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Obligatoria para RealTime Database (Tasks). Tiene esta forma:
# https://<project-id>-default-rtdb.firebaseio.com
VITE_FIREBASE_DATABASE_URL=

# Opcionales
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
